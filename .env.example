# Copy this file to .env and fill in values for your setup.
# .env is gitignored; .env.example is committed.

# ── Module selection ──────────────────────────────────────────────────────────

QUERY_GENERATION=concept_query    # concept_query (keyword_matching = legacy alias)
CONCEPT_MATCHER=thesaurus         # thesaurus  (used by concept_query)
KNOWLEDGE_BASE=sparql_endpoint    # sparql_endpoint | rdf_file
SELECTION=rerank                  # random | clustering | rerank (clustering and rerank need EMBEDDING)
EMBEDDING=multimodal              # metadata_text | multimodal | blank = off
EXPORTER=json                     # json
EXHIBITION_BUILDER=digital_wall   # digital_wall

# ── General ───────────────────────────────────────────────────────────────────

N_PER_BATCH=9

# ── Placeholder / dummy image filtering ──────────────────────────────────────
# Path to a reference "not available" image.  Any photo URL returned by the
# knowledge base whose image content matches this file (perceptual hash
# comparison via imagehash + Pillow) is treated as "no image".
#
# Checked when a card's thumbnail is first requested; the result is stored in
# THUMBNAIL_CACHE_DIR, so each image is downloaded once. A placeholder image is
# skipped in favour of the object's next image. Leave blank to disable.

PLACEHOLDER_IMAGE_FILE=collections/wereld_museum/notavailable.jpg

# Card images are served as small cached thumbnails via /thumb (originals are
# often 0.5–3 MB). Only images on IMAGE_HOSTS are fetched.
IMAGE_HOSTS=collectie.wereldculturen.nl
THUMBNAIL_CACHE_DIR=.cache/thumbnails
THUMBNAIL_SIZE=480

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_FILE: path to the JSON Lines run log (gitignored via *.log).
#   Leave blank to disable file logging.
# LOG_CONSOLE: set to "true" to also print each record to stdout.

LOG_FILE=runs.log
LOG_CONSOLE=false

# ── KnowledgeBase: sparql_endpoint ───────────────────────────────────────────

SPARQL_ENDPOINT_URL=https://api.colonialcollections.nl/datasets/nmvw/collection-archives/sparql

# ── ArtifactFetcher ───────────────────────────────────────────────────────────
# JSON file mapping each Artifact field (modules/artifact.py) to a SPARQL
# pattern for this graph. Defaults to the Wereld Museum mapping.

ARTIFACT_FIELDS_FILE=collections/wereld_museum/artifact_fields.json

# ── RetrievalEvaluator ────────────────────────────────────────────────────────
# Set to "diversity" to enable pool-level diversity + surprise metrics on /search.
# The sentence-transformer model (~420 MB) is downloaded once on first use.
# Leave blank to disable (metrics field will be null in the response).
# For CPU-only environments, use the MiniLM variant (~120 MB, ~2× faster).

# EMBEDDING_MODEL (the sentence-transformer) is shared with EMBEDDING=metadata_text.

RETRIEVAL_EVALUATOR=
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Embedding (object vectors for selection) ──────────────────────────────────
# EMBEDDING picks how objects become vectors for the embedding-based selection
# strategies (clustering, rerank); every strategy works with every embedding.
#   metadata_text — the Artifact fields in EMBEDDING_TEXT_FIELDS as one line of
#                   text, embedded with EMBEDDING_MODEL (the multilingual
#                   sentence-transformer, ~420 MB, shared with the
#                   RetrievalEvaluator). Fast: ~1 s per 100 objects.
#   multimodal    — image + metadata with EmbeddingGemma 2 (~1.5 GB, downloaded
#                   once; needs transformers 5.19+). ~0.3 s per object on MPS.
# Vectors are computed in the background and cached per object. The server
# keeps nothing per curator (the browser sends the pool, kept items and
# negatives with every request), so several tabs work side by side.
# Leave blank to disable: no model is loaded and clustering / rerank select at
# random. Progress: GET /embedding/status.
#
# EMBEDDING_VIEW: the vector the strategies use. metadata_text: text (only).
#   multimodal: fused (text + image in one input, default) | image | text
# EMBEDDING_TEXT_FIELDS (metadata_text): comma-separated Artifact fields, e.g.
#   title  or  title,type,material,place  (better: many objects have no title)
# Multimodal only:
# EMBEDDING_MULTIMODAL_MODEL: default google/embeddinggemma-2
# EMBEDDING_DIM: 768 (blank) or a Matryoshka truncation: 512 | 256 | 128
# EMBEDDING_DTYPE: auto (bfloat16 on CUDA, else float32) | bfloat16 | float32
#   — never float16, which breaks this model.
# EMBEDDING_DEVICE: blank = auto (cuda / mps / cpu)
# EMBEDDING_IMAGE_TOKENS: vision tokens per image, blank = model default (280).
#   Images dominate the cost (~0.8 s/object on Apple MPS at 280, ~3× slower on CPU);
#   140 is ~2× faster, 70 ~4×, with vectors close to the default (cosine ~0.98 / ~0.97).

EMBEDDING_TEXT_FIELDS=title
# EMBEDDING_VIEW=
# EMBEDDING_MULTIMODAL_MODEL=google/embeddinggemma-2
# EMBEDDING_DIM=
# EMBEDDING_DTYPE=auto
# EMBEDDING_DEVICE=
# EMBEDDING_IMAGE_TOKENS=
# EMBEDDING_BATCH_SIZE=8
# EMBEDDING_CACHE_SIZE=5000

# ── Selection: clustering ─────────────────────────────────────────────────────
# SELECTION=clustering clusters each pool on its EMBEDDING vectors, shows one
# item per cluster first, then steers towards the clusters the user kept items
# from. Needs EMBEDDING; without it selection is random.
# CLUSTERING_STEERING_WEIGHT = share of each later batch taken from kept
# clusters (0 = pure exploration, 1 = only kept clusters). The rest explores.
# CLUSTERING_SHUFFLE_STEP = how much randomness each batch in a row without
# a keep adds (0.25 → fully random after 4 empty batches; a keep resets it).
# CLUSTERING_N_CLUSTERS defaults to 2 × N_PER_BATCH, so some clusters stay
# unshown after the first batch.
# CLUSTERING_WAIT = seconds a search waits for the pool's vectors before the
# first batch (metadata_text needs ~1 s). If they are not ready by then
# (multimodal), the first batch is random and the pool is clustered as soon as
# every vector is there.

CLUSTERING_STEERING_WEIGHT=0.6
CLUSTERING_SHUFFLE_STEP=0.25
# CLUSTERING_N_CLUSTERS=18
# CLUSTERING_WAIT=3

# ── Selection: rerank ─────────────────────────────────────────────────────────
# Re-ranks the unseen pool after every batch from the curator's feedback:
# kept objects pull similar ones up, objects marked not relevant (the × on a
# card) push them down (weaker, GAMMA < BETA) and are not shown again.
# Needs EMBEDDING; without it selection is random. The first batch of a query
# is random too (no feedback yet).
#
# RERANK_SCORING: rocchio (similarity to the kept centroid) | knn (to the K
#   nearest kept objects; better when the selection has several themes)
# RERANK_MMR_LAMBDA: 1 = pure relevance, lower = more varied batches
# RERANK_EXPLORE: share of each batch picked at random (0.2 → 2 of 10)
# RERANK_WAIT: seconds /next waits for the feedback items' vectors
# RERANK_CROSS_QUERY: objects kept or marked not relevant under earlier queries
#   count as feedback (false: only those in the current pool)

# RERANK_SCORING=rocchio
# RERANK_BETA=1.0
# RERANK_GAMMA=0.5
# RERANK_K=3
# RERANK_MMR_LAMBDA=0.7
# RERANK_EXPLORE=0.2
# RERANK_WAIT=1.0
# RERANK_CROSS_QUERY=true

# ── Demo preload ──────────────────────────────────────────────────────────────
# PRELOAD_QUERIES: JSON list of queries to warm up in the background at startup
#   (for demos). Each query's pool is fetched once and stored on disk in
#   POOL_CACHE_DIR — a later search for it skips the SPARQL endpoint — its
#   thumbnails are downloaded, and (with EMBEDDING) its objects are
#   encoded into the in-memory vector cache after any live work. The queries
#   go through QUERY_GENERATION, so the bundled list needs concept_query.
#   Progress: /embedding/status → "preload". Leave blank to disable.
#   Delete POOL_CACHE_DIR to re-fetch the pools from the endpoint.

PRELOAD_QUERIES=
# PRELOAD_QUERIES=collections/wereld_museum/demo_queries.json
# POOL_CACHE_DIR=.cache/pools

# ── KnowledgeBase: rdf_file ───────────────────────────────────────────────────

RDF_FILE_PATH=

# ── ConceptMatcher: thesaurus ────────────────────────────────────────────────
# Comma-separated list of thesaurus CSV files.
# Also uses SPARQL_ENDPOINT_URL to classify concepts as type / material / origin.
# Expected columns: concept, prefLabel, broad, altLabels (pipe-separated).
# Any graph can supply its own files — the format is not collection-specific.

KEYWORD_MATCHING_THESAURUS_FILES=collections/wereld_museum/thesaurus1.csv,collections/wereld_museum/thesaurus2.csv,collections/wereld_museum/thesaurus3.csv

# ── ChatModel (AI curation assistant) ────────────────────────────────────────
# CHAT_MODEL=local_hf  runs a Hugging Face model on this machine (loaded on the
#                      first chat). Gated models (meta-llama/*) need a Hugging
#                      Face login: set HF_TOKEN, or start the app in a terminal
#                      and paste a token when asked. CHAT_DEVICE: mps | cuda |
#                      cpu (default: first available).
# CHAT_MODEL=nebula    the VU Nebula service (OpenAI-compatible). Key from
#                      Nebula → Settings → Account → API Keys. List models:
#                      python -m modules.chat_model.nebula
# Leave CHAT_MODEL blank to disable the assistant.

CHAT_MODEL=local_hf
CHAT_LOCAL_MODEL=meta-llama/Llama-3.2-1B-Instruct
# HF_TOKEN=
# CHAT_DEVICE=
NEBULA_API_KEY=
NEBULA_MODEL=deepseek-r1:1.5b

# Artifact fields sent to the model, one line per selected item (same format
# as EMBEDDING_TEXT_FIELDS). Add description for richer but
# longer context.
CHAT_CONTEXT_FIELDS=title,type,material,place,date,maker,intended_use

# ── ExhibitionBuilder: digital_wall ──────────────────────────────────────────
# "Build Exhibition" opens a wall editor with the selection. Composing the wall
# works without a key; turning it into photorealistic renders (Done → Generate)
# uses the OpenAI image-edit API and needs OPENAI_API_KEY.

OPENAI_API_KEY=
DIGITAL_WALL_IMAGE_MODEL=gpt-image-2   # e.g. gpt-image-1 if your key lacks gpt-image-2
DIGITAL_WALL_IMAGE_SIZE=1024x1024
