# Copy this file to .env and fill in values for your setup.
# .env is gitignored; .env.example is committed.

# ── Module selection ──────────────────────────────────────────────────────────

QUERY_GENERATION=category_select  # category_select | concept_query (keyword_matching = legacy alias)
CONCEPT_MATCHER=thesaurus         # thesaurus  (used by concept_query)
KNOWLEDGE_BASE=sparql_endpoint    # sparql_endpoint | rdf_file
SELECTION=random                  # random | title_cluster
EXPORTER=json                     # json

# ── General ───────────────────────────────────────────────────────────────────

N_PER_BATCH=9

# ── Collection: category labels → concept URIs ────────────────────────────────
# JSON file mapping display labels to thesaurus/concept URIs.
# Graph-specific files live under collections/<graph_name>/.
# Format: {"Label": "https://..."}

CATEGORIES_FILE=collections/wereld_museum/wereldmuseum_categories.json

# ── Placeholder / dummy image filtering ──────────────────────────────────────
# Path to a reference "not available" image.  Any photo URL returned by the
# knowledge base whose image content matches this file (perceptual hash
# comparison via imagehash + Pillow) is treated as "no image".
#
# Checked when a card's thumbnail is first requested; the result is stored in
# THUMBNAIL_CACHE_DIR, so each image is downloaded once. A placeholder image is
# skipped in favour of the object's next image. Leave blank to disable.

PLACEHOLDER_IMAGE_FILE=collections/wereld_museum/notavailable.jpg

# Card images are served as small cached thumbnails via /thumb (originals are
# often 0.5–3 MB). Only images on IMAGE_HOSTS are fetched.
IMAGE_HOSTS=collectie.wereldculturen.nl
THUMBNAIL_CACHE_DIR=.cache/thumbnails
THUMBNAIL_SIZE=480

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_FILE: path to the JSON Lines run log (gitignored via *.log).
#   Leave blank to disable file logging.
# LOG_CONSOLE: set to "true" to also print each record to stdout.

LOG_FILE=runs.log
LOG_CONSOLE=false

# ── KnowledgeBase: sparql_endpoint ───────────────────────────────────────────

SPARQL_ENDPOINT_URL=https://api.colonialcollections.nl/datasets/nmvw/collection-archives/sparql

# ── Selection: title_cluster ───────────────────────────────────────────────────────
# SELECTION=title_cluster clusters each pool by embedding one text per object,
# shows one item per cluster first, then steers towards clusters the user kept
# items from. TITLE_CLUSTER_TEXT decides the text (any Artifact fields):
#   title                                   one field (default)
#   title,type,material,place               fields joined with " · "
#   {title}[ — {type}][, made of {material}][, from {place}]
#                                           template; [...] is dropped when a
#                                           field inside it is empty
# TITLE_CLUSTER_STEERING_WEIGHT = share of each later batch taken from kept
# clusters (0 = pure exploration, 1 = only kept clusters). The rest explores.
# TITLE_CLUSTER_N_CLUSTERS defaults to N_PER_BATCH. Uses EMBEDDING_MODEL.

TITLE_CLUSTER_TEXT=title
TITLE_CLUSTER_STEERING_WEIGHT=0.6
# TITLE_CLUSTER_N_CLUSTERS=9

# ── ArtifactFetcher ───────────────────────────────────────────────────────────
# JSON file mapping each Artifact field (modules/artifact.py) to a SPARQL
# pattern for this graph. Defaults to the Wereld Museum mapping.

ARTIFACT_FIELDS_FILE=collections/wereld_museum/artifact_fields.json

# ── RetrievalEvaluator ────────────────────────────────────────────────────────
# Set to "diversity" to enable pool-level diversity + surprise metrics on /search.
# The sentence-transformer model (~420 MB) is downloaded once on first use.
# Leave blank to disable (metrics field will be null in the response).
# For CPU-only environments, use the MiniLM variant (~120 MB, ~2× faster).

RETRIEVAL_EVALUATOR=
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── KnowledgeBase: rdf_file ───────────────────────────────────────────────────

RDF_FILE_PATH=

# ── ConceptMatcher: thesaurus ────────────────────────────────────────────────
# Comma-separated list of thesaurus CSV files.
# Also uses SPARQL_ENDPOINT_URL to classify concepts as type / material / origin.
# Expected columns: concept, prefLabel, broad, altLabels (pipe-separated).
# Any graph can supply its own files — the format is not collection-specific.

KEYWORD_MATCHING_THESAURUS_FILES=collections/wereld_museum/thesaurus1.csv,collections/wereld_museum/thesaurus2.csv,collections/wereld_museum/thesaurus3.csv
