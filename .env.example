# Copy this file to .env and fill in values for your setup.
# .env is gitignored; .env.example is committed.

# ── Module selection ──────────────────────────────────────────────────────────

QUERY_GENERATION=category_select  # category_select | keyword_matching
KNOWLEDGE_BASE=sparql_endpoint    # sparql_endpoint | rdf_file
SELECTION=relevance_feedback      # random | relevance_feedback (needs REPRESENTATION)
REPRESENTATION=embeddinggemma    # embeddinggemma | none (needed for relevance_feedback)
EXPORTER=json                     # json

# ── General ───────────────────────────────────────────────────────────────────

N_PER_BATCH=10

# ── Collection: category labels → concept URIs ────────────────────────────────
# JSON file mapping display labels to thesaurus/concept URIs.
# Graph-specific files live under collections/<graph_name>/.
# Format: {"Label": "https://..."}

CATEGORIES_FILE=collections/wereld_museum/wereldmuseum_categories.json

# ── Placeholder / dummy image filtering ──────────────────────────────────────
# Path to a reference "not available" image.  Any photo URL returned by the
# knowledge base whose image content matches this file (perceptual hash
# comparison via imagehash + Pillow) is treated as "no image".
#
# Each URL is fetched once and the result cached for the server lifetime, so
# only the first search pays the cost.  Leave blank to disable filtering.

PLACEHOLDER_IMAGE_FILE=collections/wereld_museum/notavailable.jpg

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_FILE: path to the JSON Lines run log (gitignored via *.log).
#   Leave blank to disable file logging.
# LOG_CONSOLE: set to "true" to also print each record to stdout.

LOG_FILE=runs.log
LOG_CONSOLE=false

# ── KnowledgeBase: sparql_endpoint ───────────────────────────────────────────

SPARQL_ENDPOINT_URL=https://api.colonialcollections.nl/datasets/nmvw/collection-archives/sparql

# ── RetrievalEvaluator ────────────────────────────────────────────────────────
# Set to "diversity" to enable pool-level diversity + surprise metrics on /search.
# The sentence-transformer model (~420 MB) is downloaded once on first use.
# Leave blank to disable (metrics field will be null in the response).
# For CPU-only environments, use the MiniLM variant (~120 MB, ~2× faster).

RETRIEVAL_EVALUATOR=
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Representation ────────────────────────────────────────────────────────────
# Set to "embeddinggemma" to embed every search result (image + metadata) in
# the background with EmbeddingGemma 2 and keep the vectors in memory:
#   search bank    — the current query's pool, replaced on every new query
#   selection bank — the kept objects, persists across queries
# For re-ranking / recommendation. Leave blank to disable (model never loaded).
# The model (~1.5 GB) is downloaded once on first use. One curator per server.
#
# REPRESENTATION_VIEWS: comma list of fused | image | text
#   fused = text + image in one input; image / text = each on its own.
# REPRESENTATION_DIM: 768 (blank) or a Matryoshka truncation: 512 | 256 | 128
# REPRESENTATION_DTYPE: auto (bfloat16 on CUDA, else float32) | bfloat16 | float32
#   — never float16, which breaks this model.
# REPRESENTATION_DEVICE: blank = auto (cuda / mps / cpu)
# REPRESENTATION_IMAGE_TOKENS: vision tokens per image, blank = model default (280).
#   Images dominate the cost (~0.8 s/object on Apple MPS at 280, ~3× slower on CPU);
#   140 is ~2× faster, 70 ~4×, with vectors close to the default (cosine ~0.98 / ~0.97).

REPRESENTATION=
# REPRESENTATION_MODEL=google/embeddinggemma-2
# REPRESENTATION_VIEWS=fused
# REPRESENTATION_DIM=
# REPRESENTATION_DTYPE=auto
# REPRESENTATION_DEVICE=
# REPRESENTATION_IMAGE_TOKENS=
# REPRESENTATION_BATCH_SIZE=8
# REPRESENTATION_CACHE_SIZE=5000

# ── Selection: relevance_feedback ─────────────────────────────────────────────
# Re-ranks the unseen pool after every batch from the curator's feedback:
# kept objects pull similar ones up, objects marked not relevant (the × on a
# card) push them down (weaker, GAMMA < BETA) and are not shown again.
# Needs REPRESENTATION; without it selection is random.
#
# RERANK_VIEW: fused | image | text — must be one of REPRESENTATION_VIEWS
# RERANK_SCORING: rocchio (similarity to the kept centroid) | knn (to the K
#   nearest kept objects; better when the selection has several themes)
# RERANK_MMR_LAMBDA: 1 = pure relevance, lower = more varied batches
# RERANK_EXPLORE: share of each batch picked at random (0.2 → 2 of 10)
# RERANK_WAIT: seconds /next waits for the feedback items' vectors
# RERANK_CROSS_QUERY: objects kept or marked not relevant under earlier queries
#   count as feedback (false: only those in the current pool)

# RERANK_VIEW=fused
# RERANK_SCORING=rocchio
# RERANK_BETA=1.0
# RERANK_GAMMA=0.5
# RERANK_K=3
# RERANK_MMR_LAMBDA=0.7
# RERANK_EXPLORE=0.2
# RERANK_WAIT=1.0
# RERANK_CROSS_QUERY=true

# ── KnowledgeBase: rdf_file ───────────────────────────────────────────────────

RDF_FILE_PATH=

# ── QueryGeneration: keyword_matching ────────────────────────────────────────
# Comma-separated list of thesaurus CSV files.
# Expected columns: concept, prefLabel, broad, altLabels (pipe-separated).
# Any graph can supply its own files — the format is not collection-specific.

KEYWORD_MATCHING_THESAURUS_FILES=collections/wereld_museum/thesaurus1.csv,collections/wereld_museum/thesaurus2.csv,collections/wereld_museum/thesaurus3.csv
